# SPDX-License-Identifier: MIT
# Development: same routes as Caddyfile, but the pages come from `next dev` (docker-compose.dev.yml).
:80 {
	encode zstd gzip

	# Single-file docs and llms.txt are plain text for humans and coding assistants.
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /llms.txt Content-Type "text/plain; charset=utf-8"

	# Bleep Play (patch/web): its modules come from the Bleep Library below (packages).

	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	header @wasm Cache-Control "public, max-age=300, must-revalidate"

	# Accounts API (website/api). Same origin as the site, so the session cookie needs no CORS.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Library downloads: the public-read bucket in SeaweedFS, anonymous, no app code in the path.
	# Releases are immutable (versioned paths) except index.json, which must revalidate.
	# handle_path strips /registry before anything else runs (a `uri strip_prefix` would run after `rewrite`, and the
	# bucket key would be registry/v1/…); the paths below are therefore without the prefix.
	handle_path /registry/* {
		@index path /v1/index.json /v1/presets/index.json
		header @index Cache-Control "no-cache"
		@versioned not path /v1/index.json /v1/presets/index.json
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		rewrite * /bleep-registry{path}
		reverse_proxy storage:8333
	}

	# next dev does not serve index files from public/ (the static export and Caddyfile do).
	rewrite /library/p/* /library/detail/

	@playroot path /play /play/
	rewrite @playroot /play/index.html
	@embedroot path /embed /embed/
	rewrite @embedroot /embed/index.html

	# Everything else (pages, /docs, /play UI from public/) is the Next dev server with hot reload.
	handle {
		reverse_proxy dev:3000
	}
}
