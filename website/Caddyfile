# Serves the static export of website/app.
:80 {
	root * /srv
	encode zstd gzip

	# Single-file docs and llms.txt are plain text for humans and coding assistants.
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /llms.txt Content-Type "text/plain; charset=utf-8"

	# Bleep Board (patch/web): wasm modules stream-compile with the right type;
	# the build names no file by hash yet, so revalidate instead of immutable.
	# The modules are not part of the image: they come from the folder mounted at /srv/play-modules
	# (scripts/build/build-web.sh --modules-only).
	handle /play/manifest.json {
		root * /srv/play-modules
		uri strip_prefix /play
		header Cache-Control "no-cache"
		file_server
	}
	handle /play/modules/* {
		root * /srv/play-modules
		uri strip_prefix /play
		file_server
	}

	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	header @wasm Cache-Control "public, max-age=300, must-revalidate"

	# Accounts API (website/api). Same origin as the site, so the session cookie needs no CORS.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Store downloads: the public-read bucket in SeaweedFS, anonymous, no app code in the path.
	# Releases are immutable (versioned paths) except index.json, which must revalidate.
	handle /registry/* {
		@index path /registry/v1/index.json /registry/v1/presets/index.json
		header @index Cache-Control "no-cache"
		header !@index Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /registry
		rewrite * /bleep-registry{uri}
		reverse_proxy storage:8333
	}

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
