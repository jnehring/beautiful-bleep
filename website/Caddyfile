# Serves the static export of website/app.
# Default: plain HTTP on :80 on purpose, TLS ends in front of this container (a load balancer or reverse proxy). Serve the site
# only over HTTPS, and set BLEEP_COOKIE_SECURE=true for the API.
# Optional automatic HTTPS: set BLEEP_SITE_ADDRESS to the domain (e.g. beautifulbleep.com) in website/.env. Caddy then gets and renews
# a Let's Encrypt certificate itself (ports 80 and 443 must be reachable from the internet, see doc/operations/website.md) and
# redirects HTTP to HTTPS. Unset or empty (compose passes :80): plain HTTP as before.
# The CSP header of a page; the arguments are the matcher and the frame-ancestors source (see "The pages" below).
(pagecsp) {
	header {args[0]} Content-Security-Policy "style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*; object-src 'none'; frame-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors {args[1]}"
}

{$BLEEP_SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	# Optional password for the whole site (HTTP basic auth), e.g. an installation that is online but not public yet.
	# Off unless BLEEP_BASIC_AUTH_HASH is set in website/.env (see .env.example). Browsers ask once and then send the
	# credentials with every request, including /api/* and /registry/*.
	# BLEEP_BASIC_AUTH_ON is "1" only when a hash is set (compose derives it); an environment variable that is set but empty does
	# not fall back to the default in Caddy, so the hash below is always a valid one: the placeholder is never used.
	@locked expression "'{$BLEEP_BASIC_AUTH_ON:}' == '1'"
	basic_auth @locked {
		{$BLEEP_BASIC_AUTH_USER:bleep} {$BLEEP_BASIC_AUTH_HASH:$2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG}
	}

	# Security headers on every response.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
		# Only honoured by browsers when the site was reached over HTTPS.
		Strict-Transport-Security "max-age=31536000"
	}

	# Nobody frames the site (clickjacking on /device/ and /account), except: the sandboxed frame of a Code node (below), Bleep Play by
	# this site's own /embed/ page, and /embed/ by anyone (sharing.md: the iframe code a patch's author copies into a forum). The embed
	# page is public and makes no call that needs a login; the third-party frame does not carry the session cookie anyway.
	@noframe not path /play/board-code-view.html /play /play/ /play/index.html /embed /embed/*
	header @noframe X-Frame-Options "DENY"
	@playframe path /play /play/ /play/index.html
	header @playframe X-Frame-Options "SAMEORIGIN"

	# The pages: no framing, no plugins, no <base>, forms and resources from here. The header deliberately has no script-src and no
	# default-src: Next's static export writes inline scripts, and each page carries its own <meta> policy with script-src and the
	# sha256 of exactly its inline scripts (website/app/scripts/csp-hashes.mjs, run by the build). A browser applies header and meta
	# together, so a script-src in the header would have to allow the hashes too, which only 'unsafe-inline' could do. Every other
	# fetch directive is therefore listed here instead of coming from default-src. The export also writes inline styles, so style-src
	# keeps 'unsafe-inline'. wasm-unsafe-eval (in the meta) is for Bleep Play compiling the modules; frame-src 'self' is for the sandboxed frame a Code node's own UI runs in (board-code-view.html, which sets its own policy: no network); ws://127.0.0.1 is its
	# bridge to the Bleep App on the same computer. The one argument is frame-ancestors.
	@pages not path /registry/* /play/board-code-view.html /play /play/ /play/index.html /embed /embed/*
	import pagecsp @pages 'none'
	import pagecsp @playframe 'self'
	@embed path /embed /embed/*
	import pagecsp @embed *

	# The one page that is framed: a Code node's own UI (board-code-view.html) is embedded by Bleep Play, from the same origin.
	# It sets its own policy (a meta tag: no network), so the header here only controls who may frame it.
	@codeview path /play/board-code-view.html
	header @codeview Content-Security-Policy "frame-ancestors 'self'"
	header @codeview X-Frame-Options "SAMEORIGIN"

	# Library files are data, never pages: whatever a release uploaded cannot run script in the site's origin (it shares the session cookie's origin).
	@registry path /registry/*
	header @registry Content-Security-Policy "default-src 'none'; sandbox"

	# Single-file docs and llms.txt are plain text for humans and coding assistants.
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /llms.txt Content-Type "text/plain; charset=utf-8"

	# Bleep Play (patch/web): its modules come from the Bleep Library below (packages).

	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"
	header @wasm Cache-Control "public, max-age=300, must-revalidate"

	# Accounts API (website/api). Same origin as the site, so the session cookie needs no CORS.
	# Request bodies are capped here as well as in the API: 1 MiB for everything, 1 GiB for the store's uploads (the API
	# applies the exact per-file limits). The registry block comes first: the first matching handle wins.
	handle /api/registry/* {
		request_body {
			max_size 1GiB
		}
		reverse_proxy api:8000
	}
	handle /api/presets* {
		request_body {
			max_size 8MiB
		}
		reverse_proxy api:8000
	}
	handle /api/projects* {
		request_body {
			max_size 3MiB
		}
		reverse_proxy api:8000
	}
	handle /api/* {
		request_body {
			max_size 1MiB
		}
		reverse_proxy api:8000
	}

	# Library downloads: the public-read bucket in SeaweedFS, anonymous, no app code in the path.
	# Releases are immutable (versioned paths) except index.json, which must revalidate.
	# handle_path strips /registry before anything else runs (a `uri strip_prefix` would run after `rewrite`, and the
	# bucket key would be registry/v1/…); the paths below are therefore without the prefix.
	handle_path /registry/* {
		@index path /v1/index.json /v1/presets/index.json
		header @index Cache-Control "no-cache"
		@versioned not path /v1/index.json /v1/presets/index.json
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		rewrite * /bleep-registry{path}
		reverse_proxy storage:8333
	}

	# /library/p/<pid>/<version> is the library page of one version of a patch (sharing.md); the static page reads the path.
	rewrite /library/p/* /library/detail/

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
