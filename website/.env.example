# Copy to website/.env (git-ignored) and fill in.
POSTGRES_PASSWORD=change-me
# The first admin, created on API start if no user has this email. Remove the password afterwards.
BLEEP_ADMIN_EMAIL=you@example.com
BLEEP_ADMIN_PASSWORD=change-me-too-12345
# true when the site is served over HTTPS: PRODUCTION MUST BE true (false sends the session cookie in the clear).
# false only for local http://localhost development.
BLEEP_COOKIE_SECURE=false
# Outgoing email for registration confirmation and password reset. Leave BLEEP_SMTP_HOST empty to only log the messages.
# Gmail: turn on 2-step verification, create an app password (myaccount.google.com/apppasswords), paste it here without spaces.
# true: registering sends a confirmation link. false: no link, nobody is asked to confirm (password reset still works).
BLEEP_EMAIL_VERIFICATION=true
# Local development without SMTP: true writes the whole mail (with the one-time links) to the API log; read the confirmation link there.
# Leave false anywhere else: the log would hold working login/reset links.
BLEEP_LOG_MAIL_BODIES=false
BLEEP_SMTP_HOST=smtp.gmail.com
BLEEP_SMTP_PORT=587
BLEEP_SMTP_USER=beautifulbleep@gmail.com
BLEEP_SMTP_PASSWORD=
# Where the contact form delivers messages (default: BLEEP_SMTP_USER).
BLEEP_CONTACT_TO=
# The links in the emails point here (no trailing slash): the address people reach the site at.
# Production: https://beautifulbleep.com (and BLEEP_COOKIE_SECURE=true). Local: http://localhost:8080
BLEEP_PUBLIC_URL=http://localhost:8080
# Object storage for releases and preset files (SeaweedFS). Used by the API and scripts/release.py.
S3_ACCESS_KEY=bleep
S3_SECRET_KEY=change-me-three-12345
# Code signing: releases are refused without a valid developer signature (website/content/developers/modules/signing.md).
# Make the values once with:  scripts/release/signing.py init-registry ~/bleep-registry-keys
# and paste the lines it writes to registry.env here. Keep root.key OFFLINE (your keystore), never in this file.
BLEEP_ROOT_PUBLIC_KEYS=
BLEEP_ISSUER_KEY=
BLEEP_ISSUER_CERT=
BLEEP_REQUIRE_SIGNATURES=true
# Which proxy addresses the API believes for X-Forwarded-For (rate limits and the sign-in warning use the visitor's address). The default is
# the private networks Docker uses (172.16.0.0/12, 10.0.0.0/8, 192.168.0.0/16): set it only if your reverse proxy has another address.
# FORWARDED_ALLOW_IPS=
# Optional password for the whole site (HTTP basic auth in Caddy), to keep an online installation private. Off while the hash is empty.
# Make the hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
# and paste it in SINGLE quotes (the hash contains $ characters, which Compose would otherwise expand).
# Applies to everything, including /api and /registry, so the Bleep App and Bleep Play cannot reach a protected site.
BLEEP_BASIC_AUTH_USER=bleep
BLEEP_BASIC_AUTH_HASH=
# Automatic HTTPS (optional). Default: Caddy serves plain HTTP on port 80 and TLS ends in front of the container (a load balancer).
# To let Caddy get its own Let's Encrypt certificate: point the domain's DNS at this host, open ports 80 and 443, and set
#   BLEEP_SITE_ADDRESS=beautifulbleep.com   BLEEP_SITE_PORT=80   BLEEP_SITE_TLS_PORT=443   BLEEP_COOKIE_SECURE=true   BLEEP_PUBLIC_URL=https://beautifulbleep.com
# (certificates live in the caddy-data volume). Leave these unset for the plain-HTTP setup.
# BLEEP_SITE_ADDRESS=
# BLEEP_SITE_TLS_PORT=8443

# The patch assistant: a chat in the board that answers questions, diagnoses and edits patches (agent/, doc/specs/agent.md).
# Off unless true. Needs the data from scripts/build/build-agent-data.sh in website/api/agent_data/ and a model provider key.
BLEEP_AGENT_ENABLED=false
# Tokens (input + output) per UTC day for ALL users together; when used up the assistant answers "come back tomorrow".
BLEEP_AGENT_DAILY_TOKENS=1000000
# Models: <provider>:<name> or a bare name (gemini-... is read as google-gla:gemini-..., gpt-... as openai:gpt-...).
BLEEP_AGENT_MODEL=google-gla:gemini-3.8-flash
BLEEP_AGENT_EMBED_MODEL=gemini-embedding-2
# Provider keys, under the providers' own names: GOOGLE_API_KEY (Google AI Studio, for gemini-* models and embeddings), OPENAI_API_KEY (gpt-* models).
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Chat requests per user per minute; 0 = no limit.
BLEEP_AGENT_USER_PER_MINUTE=6
# Signs the resume tokens of paused runs. Empty: random per start (a restart then ends runs that are waiting for the browser).
BLEEP_AGENT_STATE_SECRET=
